# --- Aplicación ---
# URL pública de la app (sin barra final). En Vercel: https://<su-proyecto>.vercel.app
APP_URL=http://localhost:3000

# --- Base de datos (Supabase / Neon / PostgreSQL) ---
# En Supabase use la cadena del "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruido

# --- Autenticación (Auth.js) ---
# Generar con: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Almacenamiento de archivos (S3 / Supabase Storage / Cloudflare R2) ---
# "s3" en producción, "local" para desarrollo (archivos en .uploads/)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Supabase: https://<ref>.supabase.co/storage/v1/s3   ·   R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para Supabase Storage
S3_FORCE_PATH_STYLE=true

# --- Motor de cálculo Python (engine/) ---
ENGINE_URL=http://127.0.0.1:8000
# La misma clave configurada en el motor. Generar con: openssl rand -hex 32
ENGINE_API_KEY=
